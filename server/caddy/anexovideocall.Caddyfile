# ============================================================================
# ANEXOVIDEOCALL — TURN host ka HTTPS face (Server 2)
# TURN media UDP 3478/5349 + 49152-49500 par SEEDHA coturn pe jata hai; Caddy
# sirf is hostname ka TLS cert leta hai (wahi cert coturn use karta hai) aur
# health face Rust ki asli readiness se aata hai; static/fake 200 nahi.
# ============================================================================
anexovideocall.anexomail.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /health {
		rewrite * /rpc/health
		reverse_proxy 127.0.0.1:3200
	}

	handle /ready {
		rewrite * /rpc/chat.turn.health
		reverse_proxy 127.0.0.1:3200
	}

	handle {
		rewrite * /rpc/chat.turn.health
		reverse_proxy 127.0.0.1:3200
	}

	log {
		output file /var/log/caddy/anexovideocall.log
		format json
	}
}
