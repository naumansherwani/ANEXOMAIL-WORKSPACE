{
        email admin@nexatect.com
        servers {
                protocols h1 h2 h3
        }
}
anexomail.com, www.anexomail.com {
	# founder surface awam host par band (locked)
	handle /app/founder* {
		respond "Not found" 404
	}
	# Phase 13/14/15 — Rust large-file chunk path
	handle /file/* {
		reverse_proxy 127.0.0.1:3200
	}
	handle /wt/* {
		reverse_proxy 127.0.0.1:3200
	}
	request_body {
		max_size 32MB
	}
	# POLAR RUST PAYMENT ENGINE (:3400)
	handle /api/v1/polar-webhook* {
		reverse_proxy 127.0.0.1:3400
	}
	handle /api/v1/checkout* {
		reverse_proxy 127.0.0.1:3400
	}
	handle /api/v1/billing/* {
		reverse_proxy 127.0.0.1:3400
	}
        encode gzip zstd
# (G38) /files/* band: attachments ab sirf login-wali /file/attach/get se milte hain
        handle /rpc/* {
                reverse_proxy localhost:3200
        }
        handle /api/chat/* {
                reverse_proxy localhost:3300
        }
        handle /api/* {
                reverse_proxy localhost:3100
        }
        handle /health {
                reverse_proxy localhost:3100
        }
        handle {
                reverse_proxy localhost:3000
        }
}
app.anexomail.com {
        encode gzip zstd
        reverse_proxy localhost:3000
}
