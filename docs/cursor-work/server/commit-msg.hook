#!/bin/sh
# founder 11 Nov 2026 17:27: every commit that touches founder code or SQL must NAME its phase and the latest technology it uses. Install: cp docs/cursor-work/server/commit-msg.hook .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
if git diff --cached --name-only | grep -qE '^(founder-web/src|server/founder/src|docs/cursor-work/sql)/'; then
  grep -qE '^Phase: [A-Z][A-Za-z0-9-]*' "$1" || { echo "COMMIT REFUSED: founder code needs a line  Phase: <letter>  (docs/claude/TECH-FIRST-PROTOCOL.md)"; exit 1; }
  grep -qE '^Tech: .{12,}' "$1" || { echo "COMMIT REFUSED: founder code needs a line  Tech: <the latest listed technology this code uses, e.g. Rust WASM kernel + WebTransport HTTP/3>"; exit 1; }
fi
exit 0
