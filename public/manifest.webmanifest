{
  "name": "ANEXOMAIL Workspace",
  "short_name": "ANEXOMAIL",
  "description": "Private business email workspace on your own domain — mail, people, calendar and work on one surface.",
  "id": "/app",
  "start_url": "/app/mail/inbox",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/app/mail/inbox" },
    { "name": "Calendar", "url": "/app/calendar" },
    { "name": "Search", "url": "/app/search" }
  ]
}